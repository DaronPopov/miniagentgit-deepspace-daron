{
  "name": "miniagentgit",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "deepspace dev start",
    "build": "vite build",
    "deploy": "deepspace deploy",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:size": "node scripts/check-source-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run check:ci-fingerprint && npm run check:size && npm test && npm run build",
    "ci:fingerprint": "node scripts/ci-fingerprint.mjs",
    "check:ci-fingerprint": "node scripts/ci-fingerprint.mjs --check"
  },
  "dependencies": {
    "deepspace": "0.44.2",
    "hono": "^4.13.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@generouted/react-router": "^1.20.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "0.27.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "miniflare": "5.20261110.0-beta",
    "prettier": "3.8.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.79.0"
  },
  "private": true,
  "packageManager": "npm@11.16.0"
}
